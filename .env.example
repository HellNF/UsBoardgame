# Copia in .env.local. Valori locali: `pnpm db:start` li stampa (o `pnpm supabase status`).

# Pubbliche (anche nel browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo server: bypassa RLS. Mai con prefisso NEXT_PUBLIC_, mai nel client.
SUPABASE_SECRET_KEY=sb_secret_...
